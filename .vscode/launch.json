{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nemara Homes - Debug",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=env/dev.json"],
      "env": {
        "FLUTTER_MODE": "debug"
      }
    },
    {
      "name": "Nemara Homes - Release",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--release", "--dart-define-from-file=env/prod.json"],
      "env": {
        "FLUTTER_MODE": "release"
      }
    },
    {
      "name": "Nemara Homes - Profile",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--profile", "--dart-define-from-file=env/dev.json"],
      "env": {
        "FLUTTER_MODE": "profile"
      }
    }
  ]
}
